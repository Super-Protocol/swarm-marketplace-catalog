 "metrics": [
  {
   "code": "adequate_prep_rate",
   "displayName": "Adequate Prep Rate",
   "description": "Proportion of procedures with adequate (Excellent or Good) bowel preparation",
   "dataset": "procedures",
   "kind": "aggregate",
   "expression": "countIf(bowel_prep_quality in ('Excellent', 'Good')) / countIf(bowel_prep_quality != '')",
   "filter": null,
   "format": {
    "kind": "percent"
   },
   "polarity": "higher_is_better",
   "additivity": "non_additive",
   "defaultTimeGrain": null,
   "llmVisible": true,
   "status": "published",
   "proposedBy": {
    "kind": "agent",
    "threadId": "281bc712-c2c9-4f6c-b771-1e58995e5876",
    "reason": "Adequate bowel preparation rate (target >= 85%)."
   }
  },
  {
   "code": "cecal_intubation_rate",
   "displayName": "Cecal Intubation Rate",
   "description": "Proportion of colonoscopies with verified cecal intubation",
   "dataset": "procedures",
   "kind": "aggregate",
   "expression": "avg(cecal_intubation)",
   "filter": null,
   "format": {
    "kind": "percent"
   },
   "polarity": "higher_is_better",
   "additivity": "non_additive",
   "defaultTimeGrain": null,
   "llmVisible": true,
