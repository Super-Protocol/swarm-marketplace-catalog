[
 {
  "id": "3e17e642-4cd0-4912-978d-dc49838ad983",
  "title": "Cross-Site Benchmark",
  "description": "Cross-site benchmark comparing quality metrics across clinics",
  "type": "CHART",
  "visibility": "PRIVATE",
  "ownerId": "0b765d5d-4f65-49f8-9f33-684e63753de1",
  "visualizationSpec": {
   "width": "container",
   "autosize": {
    "type": "fit",
    "contains": "padding"
   },
   "transform": [
    {
     "fold": [
      "adequate_prep_rate",
      "cecal_intubation_rate"
     ],
     "as": [
      "metric_name",
      "metric_value"
     ]
    },
    {
     "calculate": "datum.metric_name == 'adequate_prep_rate' ? 'Adequate Prep Rate' : 'Cecal Intubation Rate'",
     "as": "Metric"
    }
   ],
   "mark": {
    "type": "bar"
   },
   "encoding": {
    "x": {
     "field": "site__label",
     "type": "nominal",
     "title": "Clinical Site",
     "axis": {
      "labelAngle": 0
     }
    },
    "xOffset": {
     "field": "Metric"
    },
    "y": {
     "field": "metric_value",
     "type": "quantitative",
     "title": "Rate",
     "axis": {
      "format": ".1%"
     }
    },
    "color": {
     "field": "Metric",
     "type": "nominal",
     "scale": {
      "range": [
       "#1f77b4",
       "#2ca02c"
      ]
     }
    },
    "tooltip": [
     {
      "field": "site__label",
      "type": "nominal",
      "title": "Site"
     },
     {
      "field": "Metric",
      "type": "nominal",
      "title": "Metric"
     },
     {
      "field": "metric_value",
      "type": "quantitative",
      "title": "Rate",
      "format": ".1%"
     }
    ]
   }
  },
  "kind": "semantic",
  "query": {
   "version": 1,
   "dataset": "procedures",
   "metrics": [
    {
     "metric": "adequate_prep_rate",
     "alias": "adequate_prep_rate"
    },
    {
     "metric": "cecal_intubation_rate",
     "alias": "cecal_intubation_rate"
    }
   ],
   "groupBy": [
    {
     "dimension": "clinical_site",
     "alias": "site",
     "withLabel": true
    }
   ],
   "filters": [
    {
     "dimension": "clinical_site",
     "op": "in",
     "param": "filter_site"
    },
    {
     "dimension": "endoscopist",
     "op": "in",
     "param": "filter_endoscopist"
    },
    {
     "dimension": "procedure_type",
     "op": "in",
     "param": "filter_procedure_type"
    }
   ],
   "orderBy": [
    {
     "ref": "site",
     "direction": "asc"
    }
   ],
   "limit": 50,
   "having": [],
   "parameters": [
    {
     "name": "filter_site",
     "dimension": "clinical_site",
     "type": "members",
     "required": false
    },
    {
     "name": "filter_endoscopist",
     "dimension": "endoscopist",
     "type": "members",
     "required": false
    },
    {
     "name": "filter_procedure_type",
     "dimension": "procedure_type",
     "type": "members",
     "required": false
    }
   ]
  },
  "parameterValues": {},
  "customSql": null,
  "customBindings": null,
